<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ===== Premium Geometric Theme ===== -->
    
    <style name="Theme.CivilEg" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Main colors - Premium Geometric Palette -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/onPrimary</item>
        <item name="colorPrimaryContainer">@color/primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/onPrimaryContainer</item>
        
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/onSecondary</item>
        <item name="colorSecondaryContainer">@color/secondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/onSecondaryContainer</item>
        
        <item name="colorTertiary">@color/tertiary</item>
        <item name="colorOnTertiary">@color/onTertiary</item>
        <item name="colorTertiaryContainer">@color/tertiaryContainer</item>
        <item name="colorOnTertiaryContainer">@color/onTertiaryContainer</item>
        
        <!-- Status & Background -->
        <item name="android:windowBackground">@color/background</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/onSurface</item>
        <item name="colorSurfaceVariant">@color/surfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/onSurfaceVariant</item>
        
        <item name="android:statusBarColor">@color/primary</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/surface</item>
        
        <!-- Components Style - Premium Geometric -->
        <item name="materialCardViewStyle">@style/Widget.App.Card_Geometric</item>
        <item name="materialButtonStyle">@style/Widget.App.Button_Geometric.Primary</item>
        <item name="textInputStyle">@style/Widget.App.TextInputLayout_Geometric</item>
        
        <!-- Premium Component Overrides -->
        <item name="colorControlNormal">@color/text_secondary</item>
        <item name="colorControlActivated">@color/primary</item>
        <item name="android:textColorHint">@color/text_muted</item>
        <item name="colorError">@color/danger</item>
        <item name="colorOnError">@color/onError</item>
        
        <!-- Ripple Theme -->
        <item name="colorControlHighlight">@color/primaryContainer</item>
    </style>
    
    <!-- Premium Dark Theme -->
    <style name="Theme.CivilEg.Dark" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Dark geometric theme colors -->
        <item name="colorPrimary">#0F172A</item>
        <item name="colorOnPrimary">#F8FAFC</item>
        <item name="colorPrimaryContainer">#1E293B</item>
        <item name="colorOnPrimaryContainer">#F1F5F9</item>
        
        <item name="colorSecondary">#4A5C7E</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="colorSecondaryContainer">#1E293B</item>
        <item name="colorOnSecondaryContainer">#F1F5F9</item>
        
        <item name="colorSurface">#0F172A</item>
        <item name="colorOnSurface">#F8FAFC</item>
        <item name="colorSurfaceVariant">#1E293B</item>
        <item name="colorOnSurfaceVariant">#64748B</item>
        
        <item name="android:windowBackground">#0F172A</item>
        <item name="android:statusBarColor">#0F172A</item>
        <item name="android:navigationBarColor">#0F172A</item>
    </style>
    
    <!-- Premium Component Styles -->
    
    <!-- Geometric Elevated Card -->
    <style name="Widget.App.Card_Elevated" parent="Widget.Material3.CardView.Elevated">
        <item name="cardElevation">8dp</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardBackgroundColor">@color/surface</item>
    </style>
    
    <!-- Geometric Pill Card -->
    <style name="Widget.App.Card_Pill" parent="Widget.Material3.CardView.Elevated">
        <item name="cardElevation">4dp</item>
        <item name="cardCornerRadius">50dp</item>
        <item name="cardBackgroundColor">@color/surface</item>
    </style>
    
    <!-- Premium Toolbar -->
    <style name="Widget.App.Toolbar_Geometric" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/primary</item>
        <item name="titleTextColor">@color/onPrimary</item>
        <item name="subtitleTextColor">@color/onPrimaryContainer</item>
    </style>
    
    <!-- Premium Bottom Navigation -->
    <style name="Widget.App.BottomNav_Geometric" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@color/primaryContainer</item>
        <item name="itemIconTint">@color/text_secondary</item>
        <item name="itemTextColor">@color/text_secondary</item>
    </style>
    
    <!-- Enhanced CheckBox Style -->
    <style name="Widget.App.CheckBox_Geometric" parent="Widget.Material3.CompoundButton.CheckBox">
        <item name="android:buttonTint">@color/primary</item>
    </style>
    
    <!-- Enhanced RadioButton Style -->
    <style name="Widget.App.RadioButton_Geometric" parent="Widget.Material3.CompoundButton.RadioButton">
        <item name="android:buttonTint">@color/primary</item>
    </style>
    
    <!-- Premium Switch Style -->
    <style name="Widget.App.Switch_Geometric" parent="Widget.Material3.CompoundButton.Switch">
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>
</resources>