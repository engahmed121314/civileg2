<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ===== Premium Component Styles ===== -->
    
    <!-- Numpad Button Style -->
    <style name="Widget.App.NumpadButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">20sp</item>
    </style>
    
    <!-- Card View Style -->
    <style name="Widget.App.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardElevation">@dimen/card_elevation_md</item>
        <item name="cardCornerRadius">@dimen/card_radius_lg</item>
        <item name="cardBackgroundColor">@color/surface</item>
    </style>
    
    <!-- Geometric Button Styles -->
    
    <style name="Widget.App.Button_Geometric.Primary" parent="Widget.Material3.Button">
        <item name="android:textColor">@color/onPrimary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">@dimen/text_size_m</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:minWidth">@dimen/button_min_width</item>
    </style>
    
    <style name="Widget.App.Button_Geometric.Secondary_Outline" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">@color/secondary</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textSize">@dimen/text_size_m</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:minWidth">@dimen/button_min_width</item>
    </style>
    
    <style name="Widget.App.Button_Geometric.Pill" parent="Widget.Material3.Button">
        <item name="android:textColor">@color/onPrimary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">@dimen/text_size_m</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:minWidth">88dp</item>
    </style>
    
    <style name="Widget.App.Button_Geometric.Ghost" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textSize">@dimen/text_size_m</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:minWidth">@dimen/button_min_width</item>
    </style>
    
    <!-- Text Input Layout Style -->
    <style name="Widget.App.TextInputLayout_Geometric" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/input_radius</item>
        <item name="boxCornerRadiusTopEnd">@dimen/input_radius</item>
        <item name="boxCornerRadiusBottomStart">@dimen/input_radius</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/input_radius</item>
        <item name="boxStrokeColor">@color/primary</item>
        <item name="hintTextColor">@color/primary</item>
    </style>
    
    <!-- Shape Appearance Styles -->
    
    <style name="ShapeAppearance.App.Geometric.SmallComponent" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerSize">@dimen/card_radius_sm</item>
    </style>
    
    <style name="ShapeAppearance.App.Geometric.MediumComponent" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerSize">@dimen/card_radius</item>
    </style>
    
    <style name="ShapeAppearance.App.Geometric.LargeComponent" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerSize">@dimen/card_radius_lg</item>
    </style>
    
    <style name="ShapeAppearance.App.Geometric.PillComponent" parent="ShapeAppearance.Material3.Corner.Full">
        <item name="cornerSize">@dimen/card_radius_pill</item>
    </style>
    
    <!-- Premium Card Style -->
    <style name="Widget.App.Card_Geometric" parent="Widget.Material3.CardView.Elevated">
        <item name="cardElevation">@dimen/card_elevation_md</item>
        <item name="cardCornerRadius">@dimen/card_radius_lg</item>
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="shapeAppearance">@style/ShapeAppearance.App.Geometric.MediumComponent</item>
    </style>
    
    <!-- Surface View -->
    <style name="Widget.App.Surface_Geometric" parent="Widget.Material3.CardView.Filled">
        <item name="android:background">@color/surface</item>
    </style>
    
    <!-- Toolbar/Action Bar -->
    <style name="Widget.App.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/primary</item>
        <item name="titleTextColor">@color/onPrimary</item>
        <item name="subtitleTextColor">@color/onPrimaryContainer</item>
    </style>
    
    <!-- Bottom Navigation Item -->
    <style name="Widget.App.BottomNav_Item" parent="Widget.Material3.BottomNavigationView">
        <item name="android:minWidth">0dp</item>
    </style>
    
    <!-- Alert Dialog (removed: unused and its implicit parent Widget.App does not exist;
         nothing in the codebase referenced this style) -->
    
    <!-- Progress Bar -->
    <style name="Widget.App.ProgressBar" parent="Widget.Material3.CircularProgressIndicator">
        <item name="indicatorColor">@color/primary</item>
    </style>
    
    <!-- Tab Style -->
    <style name="Widget.App.Tab" parent="Widget.Material3.TabLayout">
        <item name="android:minHeight">48dp</item>
    </style>
</resources>