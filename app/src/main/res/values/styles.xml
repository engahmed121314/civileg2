<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ===== Premium Geometric Component Styles ===== -->
    
    <!-- Premium Numpad Button Style -->
    <style name="Widget.App.NumpadButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">20sp</item>
        <item name="strokeColor">@color/text_secondary</item>
    </style>
    
    <!-- Premium Card View Style -->
    <style name="Widget.App.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardElevation">@dimen/card_elevation_md</item>
        <item name="cardCornerRadius">@dimen/card_radius_lg</item>
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.App.Geometric.MediumComponent</item>
    </style>
    
    <!-- Premium Geometric Button Styles -->
    
    <!-- Primary Geometric Button: Gradient background, large radius -->
    <style name="Widget.App.Button_Geometric.Primary" parent="Widget.Material3.Button">
        <item name="android:background">@null</item>
        <item name="android:textColor">@color/onPrimary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">@dimen/text_size_m</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:minWidth">@dimen/button_min_width</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <!-- Ripple color from primary container -->
        <item name="android:foreground">?android:attr/selectableItemBackgroundBorderless</item>
    </style>
    
    <!-- Secondary Outline Geometric Button -->
    <style name="Widget.App.Button_Geometric.Secondary_Outline" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:background">@null</item>
        <item name="android:textColor">@color/secondary</item>
        <item name="android:textStyle">medium</item>
        <item name="android:textSize">@dimen/text_size_m</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:minWidth">@dimen/button_min_width</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:strokeColor">@color/secondary</item>
        <item name="android:strokeWidth">1.5dp</item>
        <!-- Outline background on press -->
        <item name="android:foreground">?android:attr/selectableItemBackgroundBorderless</item>
    </style>
    
    <!-- Pill Button for actions -->
    <style name="Widget.App.Button_Geometric.Pill" parent="Widget.Material3.Button">
        <item name="android:background">@null</item>
        <item name="android:textColor">@color/onPrimary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">@dimen/text_size_m</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:minWidth">88dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <!-- Ripple color -->
        <item name="android:foreground">?android:attr/selectableItemBackgroundBorderless</item>
    </style>
    
    <!-- Ghost Button (transparent with subtle border) -->
    <style name="Widget.App.Button_Geometric.Ghost" parent="Widget.Material3.Button.Borderless">
        <item name="android:background">@null</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textStyle">medium</item>
        <item name="android:textSize">@dimen/text_size_m</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:minWidth">@dimen/button_min_width</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:backgroundTint">@android:color/transparent</item>
        <item name="android:foreground">?android:attr/selectableItemBackgroundBorderless</item>
        <item name="android:outlineSpotlightColor">@color/outlineVariant</item>
    </style>
    
    <!-- Premium Text Input Layout Style -->
    <style name="Widget.App.TextInputLayout_Geometric" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusStart">@dimen/input_radius</item>
        <item name="boxCornerRadiusEnd">@dimen/input_radius</item>
        <item name="boxStrokeColor">@color/primary</item>
        <item name="hintTextColor">@color/primary</item>
        <item name="android:paddingTop">@dimen/input_height</item>
        <item name="android:paddingBottom">@dimen/input_height</item>
        <item name="android:letterSpacing">0.02</item>
        <!-- Focused state enhancement -->
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>
    
    <!-- Premium Shape Appearance Styles -->
    
    <style name="ShapeAppearance.App.Geometric.SmallComponent" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerSize">@dimen/card_radius_sm</item>
    </style>
    
    <style name="ShapeAppearance.App.Geometric.MediumComponent" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerSize">@dimen/card_radius</item>
    </style>
    
    <style name="ShapeAppearance.App.Geometric.LargeComponent" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerSize">@dimen/card_radius_lg</item>
    </style>
    
    <style name="ShapeAppearance.App.Geometric.PillComponent" parent="ShapeAppearance.Material3.PillComponent">
        <item name="cornerSize">@dimen/card_radius_pill</item>
    </style>
    
    <!-- Premium Card Style -->
    <style name="Widget.App.Card_Geometric" parent="Widget.Material3.CardView.Elevated">
        <item name="cardElevation">@dimen/card_elevation_md</item>
        <item name="cardCornerRadius">@dimen/card_radius_lg</item>
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="shapeAppearance">@style/ShapeAppearance.App.Geometric.MediumComponent</item>
        <!-- Shadow enhancement -->
        <item name="android:layout_margin">@dimen/spacing_s</item>
    </style>
    
    <!-- Premium Surface View -->
    <style name="Widget.App.Surface_Geometric" parent="Widget.Material3.Surface">
        <item name="android:background">@color/surface</item>
        <item name="shapeAppearance">@style/ShapeAppearance.App.Geometric.MediumComponent</item>
    </style>
    
    <!-- Premium Toolbar/Action Bar -->
    <style name="Widget.App.Toolbar" parent="Widget.Material3.ActionBar">
        <item name="titleTextAppearance">@style/TextAppearance.AppCompat.Title</item>
        <item name="subtitleTextAppearance">@style/TextAppearance.AppCompat.Subtitle</item>
        <item name="navigationIcon">@mipmap/ic_launcher_round</item>
        <item name="android:background">@color/primary</item>
        <item name="android:titleTextColor">@color/onPrimary</item>
        <item name="android:subtitleTextColor">@color/onPrimaryVariant</item>
    </style>
    
    <!-- Premium Bottom Navigation Item -->
    <style name="Widget.App.BottomNav_Item" parent="Widget.Material3.NavigationBar.NavigationBarItem">
        <item name="android:minWidth">0dp</item>
        <item name="android:padding">@dimen/spacing_xs</item>
    </style>
    
    <!-- Premium Navigation Item -->
    <style name="Widget.App.Navigation_Item" parent="Widget.Material3.NavigationView.NavigationItem">
        <item name="android:padding">@dimen/spacing_m</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">48dp</item>
    </style>
    
    <!-- Premium Alert Dialog -->
    <style name="Widget.App.AlertDialog" parent="Widget.Material3.Dialog.Alert">
        <item name="android:background">@color/background</item>
        <item name="android:padding">@dimen/spacing_l</item>
        <item name="android:titleTextAppearance">@style/TextAppearance.AppCompat.Title</item>
        <item name="android:contentPadding">@dimen/spacing_l</item>
    </style>
    
    <!-- Premium Progress Bar -->
    <style name="Widget.App.ProgressBar" parent="Widget.Material3.ProgressBar">
        <item name="android:progressBackgroundColor">@color/surfaceVariant</item>
        <item name="android:progressTint">@color/primary</item>
    </style>
    
    <!-- Premium Tab Style -->
    <style name="Widget.App.Tab" parent="Widget.Material3.Tab">
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:maxWidth">80dp</item>
    </style>
</resources>