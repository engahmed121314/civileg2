<?xml version="1.0" encoding="utf-8"?>
<!--
  Full-bleed splash, approved Treatment B (IBM Plex Sans Arabic).
  Background artwork is displayed pristine: no panels, no scrim, no baked text.
  Overlays are positioned by SplashOverlayLayout, which anchors them to their
  approved ARTWORK coordinates through the actual centerCrop transform (fixed
  screen percentages are unsafe at other aspects) and falls back to inset-safe
  edges when the crop removes a clear strip. The overlay container applies
  systemBars+displayCutout insets; the background never does.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Approved pristine full-bleed artwork. centerCrop keeps it full-bleed at
         any aspect; the overlay layout computes this same transform. -->
    <ImageView
        android:id="@+id/splashBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/splash_background"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <com.civileg.app.ui.splash.SplashOverlayLayout
        android:id="@+id/splashOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- App name: approved wording "CivilEG" (no space). -->
        <TextView
            android:id="@+id/tvAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CivilEG"
            android:fontFamily="@font/ibm_plex_sans_arabic_bold"
            android:textColor="@color/splash_b_name"
            android:textSize="24sp"
            android:shadowColor="@color/splash_b_text_shadow"
            android:shadowDx="1"
            android:shadowDy="2"
            android:shadowRadius="4" />

        <!-- Prayer: exact approved wording, do not reword. -->
        <TextView
            android:id="@+id/tvPrayer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="صلى الله على محمد"
            android:fontFamily="@font/ibm_plex_sans_arabic_bold"
            android:textColor="@color/splash_b_prayer"
            android:textSize="12sp"
            android:shadowColor="@color/splash_b_text_shadow"
            android:shadowDx="1"
            android:shadowDy="2"
            android:shadowRadius="4" />

        <!-- Caption above the bar. -->
        <TextView
            android:id="@+id/tvCaption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="جاري تجهيز التطبيق"
            android:fontFamily="@font/ibm_plex_sans_arabic_regular"
            android:textColor="@color/splash_b_caption"
            android:textSize="12sp"
            android:shadowColor="@color/splash_b_text_shadow"
            android:shadowDx="1"
            android:shadowDy="2"
            android:shadowRadius="4" />

        <!-- Genuinely indeterminate loading bar (see SplashLoadingBar): 50% of
             width, fully rounded, gradient fill with gold tip dot. It never
             replays a fixed percentage. -->
        <com.civileg.app.ui.splash.SplashLoadingBar
            android:id="@+id/loadingBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

    </com.civileg.app.ui.splash.SplashOverlayLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
