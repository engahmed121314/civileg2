<?xml version="1.0" encoding="utf-8"?>
<!-- Fixed for VectorDrawable compatibility: <circle>/android:rotate are not valid
     VectorDrawable elements/attributes. A circle is rotation-invariant, so the
     original 45-degree group rotation is a visual no-op and was dropped. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="200dp"
    android:height="200dp"
    android:viewportWidth="200"
    android:viewportHeight="200">
    <path
        android:fillColor="#003A70"
        android:pathData="M100,20 A80,80 0 1 1 100,180 A80,80 0 1 1 100,20 Z" />
</vector>
