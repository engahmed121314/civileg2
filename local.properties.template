# ============================================================
# Civil Engineer Pro — local.properties template (P4-3)
# Copy this file to `local.properties` (same folder) and edit.
# local.properties is GIT-IGNORED and must NEVER be committed:
# it contains machine-specific paths and production account IDs.
# ============================================================

# ── Android SDK (required — auto-generated by Android Studio) ──
# Windows: sdk.dir=C\:\\Users\\<user>\\AppData\\Local\\Android\\Sdk
# Linux:   sdk.dir=/home/<user>/Android/Sdk
# macOS:   sdk.dir=/Users/<user>/Library/Android/sdk
sdk.dir=/path/to/Android/Sdk

# ── AdMob — production IDs (optional, defaults are Google TEST IDs) ──
# Defaults serve TEST ads only and earn NO revenue. Get real IDs from
# https://apps.admob.com (Apps → Civil Engineer Pro → Ad units).
# App ID format uses '~'; ad-unit IDs use '/'.
# admob.app.id=ca-app-pub-XXXXXXXXXXXXXXXX~NNNNNNNNNN
# admob.banner.id=ca-app-pub-XXXXXXXXXXXXXXXX/NNNNNNNNNN
# admob.interstitial.id=ca-app-pub-XXXXXXXXXXXXXXXX/NNNNNNNNNN
# admob.native.id=ca-app-pub-XXXXXXXXXXXXXXXX/NNNNNNNNNN
# admob.rewarded.id=ca-app-pub-XXXXXXXXXXXXXXXX/NNNNNNNNNN

# ── Release signer fingerprint (optional, empty = check disabled) ──
# SHA-256 of the RELEASE keystore certificate. When set, the app verifies
# at runtime (AppIntegrityChecker) that it was signed with that key and
# refuses to run on repackaged APKs. Colons/lowercase are accepted.
# Obtain via:
#   keytool -list -v -keystore your-release-key.jks -alias your-alias
# (copy the "SHA256:" line)
# signing.fingerprint.sha256=AB:CD:EF:01:...:34

# ── Release signing (optional — keystore.properties preferred) ──
# See play-store/keystore-setup-guide.md. CI uses repo secrets instead:
# KEYSTORE_BASE64, KEY_ALIAS, KEY_PASSWORD, KEYSTORE_PASSWORD.
